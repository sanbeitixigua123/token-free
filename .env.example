# ---- 复制为 .env 后填写（.env 已在 .gitignore 中，不会被提交）----
# 用法：部署时在进程环境里export这些变量，或用 systemd 的 EnvironmentFile=、
#       Docker 的 --env-file、PM2 的 env 段。

# ===== 必填（上线前必须设）=====

# 管理接口鉴权令牌。不设则 /api/review、/api/crawl、/api/export、退订 全部拒绝（503）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 调用时在请求头带上：x-admin-token: <这里的值>
ADMIN_TOKEN=

# ===== 部署开关 =====

# 1 = 绑定 0.0.0.0 并启用 HSTS（生产必开）；不设 = 仅 127.0.0.1（本地开发）
DEPLOY=1

# HTTP 端口
PORT=8787

# 设为 0 可关闭内置定时抓取（改用外部调度器时；多副本部署时必须关）
# CRON=0

# ===== LLM（可选，不配则降级为纯规则抽取）=====

# 也可写入 config/secrets.json（已被 gitignore）
TOKENFREE_LLM_API_KEY=

# ===== Web Push 订阅（可选）=====

# VAPID 公钥/私钥。生成：npm run vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 推送联系邮箱，形如 mailto:you@example.com
# VAPID_SUBJECT=mailto:you@example.com
